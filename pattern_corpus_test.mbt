// Differential corpus for the pattern engine.
//
// Generated by scripts/gen-corpus.mjs: one positive and one negative case
// per published rule, with the expected answer computed by an independent
// regular-expression engine. A regression in the parser or the NFA shows up
// here as a disagreement with the reference, one rule at a time.
///|
test "the engine agrees with a reference regex engine on every rule" {
  // AC/f/example
  assert_true(@dialnumber.matches_pattern("6\\d{4}", "62889"))
  // AC/f/mutation
  assert_true(@dialnumber.matches_pattern("6\\d{4}", "62899"))
  // AC/m/example
  assert_true(@dialnumber.matches_pattern("[2-47]\\d{4}", "40123"))
  // AC/m/mutation
  assert_true(@dialnumber.matches_pattern("[2-47]\\d{4}", "40133"))
  // AC/u/example
  assert_true(@dialnumber.matches_pattern("(?:0[1-9]|[1589]\\d)\\d{4}", "542011"))
  // AC/u/mutation
  assert_true(@dialnumber.matches_pattern("(?:0[1-9]|[1589]\\d)\\d{4}", "542111"))
  // AD/f/example
  assert_true(@dialnumber.matches_pattern("[78]\\d{5}", "712345"))
  // AD/f/mutation
  assert_true(@dialnumber.matches_pattern("[78]\\d{5}", "712445"))
  // AD/m/example
  assert_true(@dialnumber.matches_pattern("690\\d{6}|[356]\\d{5}", "312345"))
  // AD/m/mutation
  assert_true(@dialnumber.matches_pattern("690\\d{6}|[356]\\d{5}", "312445"))
  // AD/t/example
  assert_true(@dialnumber.matches_pattern("180[02]\\d{4}", "18001234"))
  // AD/t/mutation
  assert_false(@dialnumber.matches_pattern("180[02]\\d{4}", "18011234"))
  // AD/p/example
  assert_true(@dialnumber.matches_pattern("[19]\\d{5}", "912345"))
  // AD/p/mutation
  assert_true(@dialnumber.matches_pattern("[19]\\d{5}", "912445"))
  // AE/f/example
  assert_true(@dialnumber.matches_pattern("[2-4679][2-8]\\d{6}", "22345678"))
  // AE/f/mutation
  assert_true(@dialnumber.matches_pattern("[2-4679][2-8]\\d{6}", "22355678"))
  // AE/m/example
  assert_true(@dialnumber.matches_pattern("5[02-68]\\d{7}", "501234567"))
  // AE/m/mutation
  assert_true(@dialnumber.matches_pattern("5[02-68]\\d{7}", "501334567"))
  // AE/t/example
  assert_true(@dialnumber.matches_pattern("400\\d{6}|800\\d{2,9}", "800123456"))
  // AE/t/mutation
  assert_true(@dialnumber.matches_pattern("400\\d{6}|800\\d{2,9}", "800223456"))
  // AE/p/example
  assert_true(@dialnumber.matches_pattern("900[02]\\d{5}", "900234567"))
  // AE/p/mutation
  assert_false(@dialnumber.matches_pattern("900[02]\\d{5}", "900334567"))
  // AE/s/example
  assert_true(@dialnumber.matches_pattern("700[05]\\d{5}", "700012345"))
  // AE/s/mutation
  assert_false(@dialnumber.matches_pattern("700[05]\\d{5}", "700112345"))
  // AE/u/example
  assert_true(@dialnumber.matches_pattern("600[25]\\d{5}", "600212345"))
  // AE/u/mutation
  assert_false(@dialnumber.matches_pattern("600[25]\\d{5}", "600312345"))
  // AF/f/example
  assert_true(@dialnumber.matches_pattern("(?:[25][0-8]|[34][0-4]|6[0-5])[2-9]\\d{6}", "234567890"))
  // AF/f/mutation
  assert_true(@dialnumber.matches_pattern("(?:[25][0-8]|[34][0-4]|6[0-5])[2-9]\\d{6}", "234667890"))
  // AF/m/example
  assert_true(@dialnumber.matches_pattern("7\\d{8}", "701234567"))
  // AF/m/mutation
  assert_true(@dialnumber.matches_pattern("7\\d{8}", "701334567"))
  // AG/f/example
  assert_true(@dialnumber.matches_pattern("268(?:4(?:6[0-38]|84)|56[0-2])\\d{4}", "2684601234"))
  // AG/f/mutation
  assert_true(@dialnumber.matches_pattern("268(?:4(?:6[0-38]|84)|56[0-2])\\d{4}", "2685601234"))
  // AG/m/example
  assert_true(@dialnumber.matches_pattern("268(?:464|7(?:1[3-9]|[28]\\d|3[0246]|64|7[0-689]))\\d{4}", "2684641234"))
  // AG/m/mutation
  assert_false(@dialnumber.matches_pattern("268(?:464|7(?:1[3-9]|[28]\\d|3[0246]|64|7[0-689]))\\d{4}", "2685641234"))
  // AG/t/example
  assert_true(@dialnumber.matches_pattern("8(?:00|33|44|55|66|77|88)[2-9]\\d{6}", "8002123456"))
  // AG/t/mutation
  assert_true(@dialnumber.matches_pattern("8(?:00|33|44|55|66|77|88)[2-9]\\d{6}", "8003123456"))
  // AG/p/example
  assert_true(@dialnumber.matches_pattern("900[2-9]\\d{6}", "9002123456"))
  // AG/p/mutation
  assert_true(@dialnumber.matches_pattern("900[2-9]\\d{6}", "9003123456"))
  // AG/v/example
  assert_true(@dialnumber.matches_pattern("26848[01]\\d{4}", "2684801234"))
  // AG/v/mutation
  assert_false(@dialnumber.matches_pattern("26848[01]\\d{4}", "2685801234"))
  // AG/r/example
  assert_true(@dialnumber.matches_pattern("52(?:3(?:[2-46-9][02-9]\\d|5(?:[02-46-9]\\d|5[0-46-9]))|4(?:[2-478][02-9]\\d|5(?:[034]\\d|2[024-9]|5[0-46-9])|6(?:0[1-9]|[2-9]\\d)|9(?:[05-9]\\d|2[0-5]|49)))\\d{4}|52[34][2-9]1[02-9]\\d{4}|5(?:00|2[125-9]|3[23]|44|66|77|88)[2-9]\\d{6}", "5002345678"))
  // AG/r/mutation
  assert_true(@dialnumber.matches_pattern("52(?:3(?:[2-46-9][02-9]\\d|5(?:[02-46-9]\\d|5[0-46-9]))|4(?:[2-478][02-9]\\d|5(?:[034]\\d|2[024-9]|5[0-46-9])|6(?:0[1-9]|[2-9]\\d)|9(?:[05-9]\\d|2[0-5]|49)))\\d{4}|52[34][2-9]1[02-9]\\d{4}|5(?:00|2[125-9]|3[23]|44|66|77|88)[2-9]\\d{6}", "5003345678"))
  // AG/g/example
  assert_true(@dialnumber.matches_pattern("26840[69]\\d{4}", "2684061234"))
  // AG/g/mutation
  assert_false(@dialnumber.matches_pattern("26840[69]\\d{4}", "2685061234"))
  // AI/f/example
  assert_true(@dialnumber.matches_pattern("264(?:292|4(?:6[12]|9[78]))\\d{4}", "2644612345"))
  // AI/f/mutation
  assert_false(@dialnumber.matches_pattern("264(?:292|4(?:6[12]|9[78]))\\d{4}", "2645612345"))
  // AI/m/example
  assert_true(@dialnumber.matches_pattern("264(?:235|4(?:69|7[67])|5(?:3[6-9]|8[1-4])|7(?:29|72))\\d{4}", "2642351234"))
  // AI/m/mutation
  assert_false(@dialnumber.matches_pattern("264(?:235|4(?:69|7[67])|5(?:3[6-9]|8[1-4])|7(?:29|72))\\d{4}", "2643351234"))
  // AI/t/example
  assert_true(@dialnumber.matches_pattern("8(?:00|33|44|55|66|77|88)[2-9]\\d{6}", "8002123456"))
  // AI/t/mutation
  assert_true(@dialnumber.matches_pattern("8(?:00|33|44|55|66|77|88)[2-9]\\d{6}", "8003123456"))
  // AI/p/example
  assert_true(@dialnumber.matches_pattern("900[2-9]\\d{6}", "9002123456"))
  // AI/p/mutation
  assert_true(@dialnumber.matches_pattern("900[2-9]\\d{6}", "9003123456"))
  // AI/r/example
  assert_true(@dialnumber.matches_pattern("52(?:3(?:[2-46-9][02-9]\\d|5(?:[02-46-9]\\d|5[0-46-9]))|4(?:[2-478][02-9]\\d|5(?:[034]\\d|2[024-9]|5[0-46-9])|6(?:0[1-9]|[2-9]\\d)|9(?:[05-9]\\d|2[0-5]|49)))\\d{4}|52[34][2-9]1[02-9]\\d{4}|5(?:00|2[125-9]|3[23]|44|66|77|88)[2-9]\\d{6}", "5002345678"))
  // AI/r/mutation
  assert_true(@dialnumber.matches_pattern("52(?:3(?:[2-46-9][02-9]\\d|5(?:[02-46-9]\\d|5[0-46-9]))|4(?:[2-478][02-9]\\d|5(?:[034]\\d|2[024-9]|5[0-46-9])|6(?:0[1-9]|[2-9]\\d)|9(?:[05-9]\\d|2[0-5]|49)))\\d{4}|52[34][2-9]1[02-9]\\d{4}|5(?:00|2[125-9]|3[23]|44|66|77|88)[2-9]\\d{6}", "5003345678"))
  // AI/g/example
  assert_true(@dialnumber.matches_pattern("264724\\d{4}", "2647241234"))
  // AI/g/mutation
  assert_false(@dialnumber.matches_pattern("264724\\d{4}", "2648241234"))
  // AL/f/example
  assert_true(@dialnumber.matches_pattern("4505[0-2]\\d{3}|(?:[2358][16-9]\\d[2-9]|4410)\\d{4}|(?:[2358][2-5][2-9]|4(?:[2-57-9][2-9]|6\\d))\\d{5}", "22345678"))
  // AL/f/mutation
  assert_true(@dialnumber.matches_pattern("4505[0-2]\\d{3}|(?:[2358][16-9]\\d[2-9]|4410)\\d{4}|(?:[2358][2-5][2-9]|4(?:[2-57-9][2-9]|6\\d))\\d{5}", "22355678"))
  // AL/m/example
  assert_true(@dialnumber.matches_pattern("6(?:[78][2-9]|9\\d)\\d{6}", "672123456"))
  // AL/m/mutation
  assert_true(@dialnumber.matches_pattern("6(?:[78][2-9]|9\\d)\\d{6}", "672223456"))
  // AL/t/example
  assert_true(@dialnumber.matches_pattern("800\\d{4}", "8001234"))
  // AL/t/mutation
  assert_true(@dialnumber.matches_pattern("800\\d{4}", "8002234"))
  // AL/p/example
  assert_true(@dialnumber.matches_pattern("900[1-9]\\d\\d", "900123"))
  // AL/p/mutation
  assert_true(@dialnumber.matches_pattern("900[1-9]\\d\\d", "900223"))
  // AL/s/example
  assert_true(@dialnumber.matches_pattern("808[1-9]\\d\\d", "808123"))
  // AL/s/mutation
  assert_true(@dialnumber.matches_pattern("808[1-9]\\d\\d", "808223"))
  // AL/r/example
  assert_true(@dialnumber.matches_pattern("700[2-9]\\d{4}", "70021234"))
  // AL/r/mutation
  assert_true(@dialnumber.matches_pattern("700[2-9]\\d{4}", "70031234"))
  // AM/f/example
  assert_true(@dialnumber.matches_pattern("(?:(?:1[0-25]|47)\\d|2(?:2[2-46]|3[1-8]|4[2-69]|5[2-7]|6[1-9]|8[1-7])|3[12]2)\\d{5}", "10123456"))
  // AM/f/mutation
  assert_true(@dialnumber.matches_pattern("(?:(?:1[0-25]|47)\\d|2(?:2[2-46]|3[1-8]|4[2-69]|5[2-7]|6[1-9]|8[1-7])|3[12]2)\\d{5}", "10133456"))
  // AM/m/example
  assert_true(@dialnumber.matches_pattern("(?:33|4[1349]|55|77|88|9[13-9])\\d{6}", "77123456"))
  // AM/m/mutation
  assert_true(@dialnumber.matches_pattern("(?:33|4[1349]|55|77|88|9[13-9])\\d{6}", "77133456"))
  // AM/t/example
  assert_true(@dialnumber.matches_pattern("800\\d{5}", "80012345"))
  // AM/t/mutation
  assert_true(@dialnumber.matches_pattern("800\\d{5}", "80022345"))
  // AM/p/example
  assert_true(@dialnumber.matches_pattern("90[016]\\d{5}", "90012345"))
  // AM/p/mutation
  assert_true(@dialnumber.matches_pattern("90[016]\\d{5}", "90022345"))
  // AM/s/example
  assert_true(@dialnumber.matches_pattern("80[1-4]\\d{5}", "80112345"))
  // AM/s/mutation
  assert_true(@dialnumber.matches_pattern("80[1-4]\\d{5}", "80122345"))
  // AM/v/example
  assert_true(@dialnumber.matches_pattern("60(?:2[78]|3[5-9]|4[02-9]|5[0-46-9]|[6-8]\\d|9[0-2])\\d{4}", "60271234"))
  // AM/v/mutation
  assert_true(@dialnumber.matches_pattern("60(?:2[78]|3[5-9]|4[02-9]|5[0-46-9]|[6-8]\\d|9[0-2])\\d{4}", "60281234"))
  // AO/f/example
  assert_true(@dialnumber.matches_pattern("2\\d(?:[0134][25-9]|[25-9]\\d)\\d{5}", "222123456"))
  // AO/f/mutation
  assert_true(@dialnumber.matches_pattern("2\\d(?:[0134][25-9]|[25-9]\\d)\\d{5}", "222223456"))
  // AO/m/example
  assert_true(@dialnumber.matches_pattern("9[1-79]\\d{7}", "923123456"))
  // AO/m/mutation
  assert_true(@dialnumber.matches_pattern("9[1-79]\\d{7}", "923223456"))
  // AR/f/example
  assert_true(@dialnumber.matches_pattern("3(?:7(?:1[15]|81)|8(?:21|4[16]|69|9[12]))[46]\\d{5}|(?:2(?:2(?:2[59]|44|52)|3(?:26|44)|47[35]|9(?:[07]2|2[26]|34|46))|3327)[45]\\d{5}|(?:2(?:657|9(?:54|66))|3(?:48[27]|7(?:55|77)|8(?:65|78)))[2-8]\\d{5}|(?:2(?:284|3(?:02|23)|477|622|920)|3(?:4(?:46|89|92)|541))[2-7]\\d{5}|(?:(?:11[0-8]|670)\\d|2(?:2(?:0[45]|1[2-6]|3[3-6])|3(?:[06]4|7[45])|494|6(?:04|1[2-8]|[36][45]|4[3-6])|80[45]|9(?:[17][4-6]|[48][45]|9[3-6]))|3(?:364|4(?:1[2-8]|[25][4-6]|3[3-6]|84)|5(?:1[2-9]|[38][4-6])|6(?:2[45]|44)|7[069][45]|8(?:0[45]|1[2-7]|3[4-6]|5[3-6]|7[2-6]|8[3-68])))\\d{6}|(?:2(?:2(?:62|81)|320|9(?:42|83))|3(?:329|4(?:62|7[16])|5(?:43|64)|7(?:18|5[17])))[2-6]\\d{5}|2(?:2(?:21|4[23]|6[145]|7[1-4]|8[356]|9[267])|3(?:16|3[13-8]|43|5[346-8]|9[3-5])|6(?:2[46]|4[78]|5[1568])|9(?:03|2[1457-9]|3[1356]|4[08]|[56][23]|82))4\\d{5}|(?:2(?:257|3(?:24|46|92)|9(?:01|23|64))|3(?:4(?:42|64)|5(?:25|37|4[47]|71)|7(?:35|72)|825))[3-6]\\d{5}|(?:2(?:2(?:02|2[3467]|4[156]|5[45]|6[6-8]|91)|3(?:1[47]|25|[45][25]|96)|47[48]|625|932)|3(?:38[2578]|4(?:0[0-24-9]|3[78]|4[457]|58|6[035-9]|72|83|9[136-8])|5(?:2[124]|[368][23]|4[2689]|7[2-6])|7(?:16|2[15]|3[14]|4[13]|5[468]|7[3-5]|8[26])|8(?:2[67]|3[278]|4[3-5]|5[78]|6[1-378]|[78]7|94)))[4-6]\\d{5}", "1123456789"))
  // AR/f/mutation
  assert_true(@dialnumber.matches_pattern("3(?:7(?:1[15]|81)|8(?:21|4[16]|69|9[12]))[46]\\d{5}|(?:2(?:2(?:2[59]|44|52)|3(?:26|44)|47[35]|9(?:[07]2|2[26]|34|46))|3327)[45]\\d{5}|(?:2(?:657|9(?:54|66))|3(?:48[27]|7(?:55|77)|8(?:65|78)))[2-8]\\d{5}|(?:2(?:284|3(?:02|23)|477|622|920)|3(?:4(?:46|89|92)|541))[2-7]\\d{5}|(?:(?:11[0-8]|670)\\d|2(?:2(?:0[45]|1[2-6]|3[3-6])|3(?:[06]4|7[45])|494|6(?:04|1[2-8]|[36][45]|4[3-6])|80[45]|9(?:[17][4-6]|[48][45]|9[3-6]))|3(?:364|4(?:1[2-8]|[25][4-6]|3[3-6]|84)|5(?:1[2-9]|[38][4-6])|6(?:2[45]|44)|7[069][45]|8(?:0[45]|1[2-7]|3[4-6]|5[3-6]|7[2-6]|8[3-68])))\\d{6}|(?:2(?:2(?:62|81)|320|9(?:42|83))|3(?:329|4(?:62|7[16])|5(?:43|64)|7(?:18|5[17])))[2-6]\\d{5}|2(?:2(?:21|4[23]|6[145]|7[1-4]|8[356]|9[267])|3(?:16|3[13-8]|43|5[346-8]|9[3-5])|6(?:2[46]|4[78]|5[1568])|9(?:03|2[1457-9]|3[1356]|4[08]|[56][23]|82))4\\d{5}|(?:2(?:257|3(?:24|46|92)|9(?:01|23|64))|3(?:4(?:42|64)|5(?:25|37|4[47]|71)|7(?:35|72)|825))[3-6]\\d{5}|(?:2(?:2(?:02|2[3467]|4[156]|5[45]|6[6-8]|91)|3(?:1[47]|25|[45][25]|96)|47[48]|625|932)|3(?:38[2578]|4(?:0[0-24-9]|3[78]|4[457]|58|6[035-9]|72|83|9[136-8])|5(?:2[124]|[368][23]|4[2689]|7[2-6])|7(?:16|2[15]|3[14]|4[13]|5[468]|7[3-5]|8[26])|8(?:2[67]|3[278]|4[3-5]|5[78]|6[1-378]|[78]7|94)))[4-6]\\d{5}", "1124456789"))
  // AR/m/example
  assert_true(@dialnumber.matches_pattern("93(?:7(?:1[15]|81)|8(?:21|4[16]|69|9[12]))[46]\\d{5}|9(?:2(?:2(?:2[59]|44|52)|3(?:26|44)|47[35]|9(?:[07]2|2[26]|34|46))|3327)[45]\\d{5}|9(?:2(?:657|9(?:54|66))|3(?:48[27]|7(?:55|77)|8(?:65|78)))[2-8]\\d{5}|9(?:2(?:284|3(?:02|23)|477|622|920)|3(?:4(?:46|89|92)|541))[2-7]\\d{5}|(?:675\\d|9(?:11[0-8]\\d|2(?:2(?:0[45]|1[2-6]|3[3-6])|3(?:[06]4|7[45])|494|6(?:04|1[2-8]|[36][45]|4[3-6])|80[45]|9(?:[17][4-6]|[48][45]|9[3-6]))|3(?:364|4(?:1[2-8]|[25][4-6]|3[3-6]|84)|5(?:1[2-9]|[38][4-6])|6(?:2[45]|44)|7[069][45]|8(?:0[45]|1[2-7]|3[4-6]|5[3-6]|7[2-6]|8[3-68]))))\\d{6}|9(?:2(?:2(?:62|81)|320|9(?:42|83))|3(?:329|4(?:62|7[16])|5(?:43|64)|7(?:18|5[17])))[2-6]\\d{5}|92(?:2(?:21|4[23]|6[145]|7[1-4]|8[356]|9[267])|3(?:16|3[13-8]|43|5[346-8]|9[3-5])|6(?:2[46]|4[78]|5[1568])|9(?:03|2[1457-9]|3[1356]|4[08]|[56][23]|82))4\\d{5}|9(?:2(?:257|3(?:24|46|92)|9(?:01|23|64))|3(?:4(?:42|64)|5(?:25|37|4[47]|71)|7(?:35|72)|825))[3-6]\\d{5}|9(?:2(?:2(?:02|2[3467]|4[156]|5[45]|6[6-8]|91)|3(?:1[47]|25|[45][25]|96)|47[48]|625|932)|3(?:38[2578]|4(?:0[0-24-9]|3[78]|4[457]|58|6[035-9]|72|83|9[136-8])|5(?:2[124]|[368][23]|4[2689]|7[2-6])|7(?:16|2[15]|3[14]|4[13]|5[468]|7[3-5]|8[26])|8(?:2[67]|3[278]|4[3-5]|5[78]|6[1-378]|[78]7|94)))[4-6]\\d{5}", "91123456789"))
  // AR/m/mutation
  assert_true(@dialnumber.matches_pattern("93(?:7(?:1[15]|81)|8(?:21|4[16]|69|9[12]))[46]\\d{5}|9(?:2(?:2(?:2[59]|44|52)|3(?:26|44)|47[35]|9(?:[07]2|2[26]|34|46))|3327)[45]\\d{5}|9(?:2(?:657|9(?:54|66))|3(?:48[27]|7(?:55|77)|8(?:65|78)))[2-8]\\d{5}|9(?:2(?:284|3(?:02|23)|477|622|920)|3(?:4(?:46|89|92)|541))[2-7]\\d{5}|(?:675\\d|9(?:11[0-8]\\d|2(?:2(?:0[45]|1[2-6]|3[3-6])|3(?:[06]4|7[45])|494|6(?:04|1[2-8]|[36][45]|4[3-6])|80[45]|9(?:[17][4-6]|[48][45]|9[3-6]))|3(?:364|4(?:1[2-8]|[25][4-6]|3[3-6]|84)|5(?:1[2-9]|[38][4-6])|6(?:2[45]|44)|7[069][45]|8(?:0[45]|1[2-7]|3[4-6]|5[3-6]|7[2-6]|8[3-68]))))\\d{6}|9(?:2(?:2(?:62|81)|320|9(?:42|83))|3(?:329|4(?:62|7[16])|5(?:43|64)|7(?:18|5[17])))[2-6]\\d{5}|92(?:2(?:21|4[23]|6[145]|7[1-4]|8[356]|9[267])|3(?:16|3[13-8]|43|5[346-8]|9[3-5])|6(?:2[46]|4[78]|5[1568])|9(?:03|2[1457-9]|3[1356]|4[08]|[56][23]|82))4\\d{5}|9(?:2(?:257|3(?:24|46|92)|9(?:01|23|64))|3(?:4(?:42|64)|5(?:25|37|4[47]|71)|7(?:35|72)|825))[3-6]\\d{5}|9(?:2(?:2(?:02|2[3467]|4[156]|5[45]|6[6-8]|91)|3(?:1[47]|25|[45][25]|96)|47[48]|625|932)|3(?:38[2578]|4(?:0[0-24-9]|3[78]|4[457]|58|6[035-9]|72|83|9[136-8])|5(?:2[124]|[368][23]|4[2689]|7[2-6])|7(?:16|2[15]|3[14]|4[13]|5[468]|7[3-5]|8[26])|8(?:2[67]|3[278]|4[3-5]|5[78]|6[1-378]|[78]7|94)))[4-6]\\d{5}", "91133456789"))
  // AR/t/example
  assert_true(@dialnumber.matches_pattern("800\\d{7,8}", "8001234567"))
  // AR/t/mutation
  assert_true(@dialnumber.matches_pattern("800\\d{7,8}", "8002234567"))
  // AR/p/example
  assert_true(@dialnumber.matches_pattern("60[04579]\\d{7}", "6001234567"))
  // AR/p/mutation
  assert_true(@dialnumber.matches_pattern("60[04579]\\d{7}", "6002234567"))
