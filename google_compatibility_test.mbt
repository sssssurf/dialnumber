    mismatches.push("typing-5/5 actual=[" + actual_5 + "]")
  }
  let actual_6 = f.input_digit('0')
  if actual_6 != "(201) 555-0" {
    mismatches.push("typing-5/6 actual=[" + actual_6 + "]")
  }
  let actual_7 = f.input_digit('1')
  if actual_7 != "(201) 555-01" {
    mismatches.push("typing-5/7 actual=[" + actual_7 + "]")
  }
  let actual_8 = f.input_digit('2')
  if actual_8 != "(201) 555-012" {
    mismatches.push("typing-5/8 actual=[" + actual_8 + "]")
  }
  let actual_9 = f.input_digit('3')
  if actual_9 != "(201) 555-0123" {
    mismatches.push("typing-5/9 actual=[" + actual_9 + "]")
  }
  let actual_10 = f.input_digit('4')
  if actual_10 != "20155501234" {
    mismatches.push("typing-5/10 actual=[" + actual_10 + "]")
  }
  let actual_11 = f.input_digit('5')
  if actual_11 != "201555012345" {
    mismatches.push("typing-5/11 actual=[" + actual_11 + "]")
  }
  let actual_12 = f.input_digit('6')
  if actual_12 != "2015550123456" {
    mismatches.push("typing-5/12 actual=[" + actual_12 + "]")
  }
  let actual_13 = f.input_digit('7')
  if actual_13 != "20155501234567" {
    mismatches.push("typing-5/13 actual=[" + actual_13 + "]")
  }
  let actual_14 = f.input_digit('8')
  if actual_14 != "201555012345678" {
    mismatches.push("typing-5/14 actual=[" + actual_14 + "]")
  }
  for mismatch in mismatches {
    println("JAVA_COMPAT " + mismatch)
  }
  assert_eq(mismatches.length(), 0)
}

///|
test "original Google Java oracle: match-0" {
  let a = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("")
  let b = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("")
  assert_eq(@dialnumber.is_number_match(a, b), @dialnumber.ExactMatch)
}

///|
test "original Google Java oracle: match-1" {
  let a = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("")
  let b = @dialnumber.PhoneNumber::new(44, "2015550123").with_extension("")
  assert_eq(@dialnumber.is_number_match(a, b), @dialnumber.NoMatch)
}

///|
test "original Google Java oracle: match-2" {
  let a = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("")
  let b = @dialnumber.PhoneNumber::new(0, "2015550123").with_extension("")
  assert_eq(@dialnumber.is_number_match(a, b), @dialnumber.NsnMatch)
}

///|
test "original Google Java oracle: match-3" {
  let a = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("")
  let b = @dialnumber.PhoneNumber::new(1, "5550123").with_extension("")
  assert_eq(@dialnumber.is_number_match(a, b), @dialnumber.ShortNsnMatch)
}

///|
test "original Google Java oracle: match-4" {
  let a = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("42")
  let b = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("")
  assert_eq(@dialnumber.is_number_match(a, b), @dialnumber.ShortNsnMatch)
}

///|
test "original Google Java oracle: match-5" {
  let a = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("42")
  let b = @dialnumber.PhoneNumber::new(1, "2015550123").with_extension("43")
  assert_eq(@dialnumber.is_number_match(a, b), @dialnumber.NoMatch)
}
