///|
test "original Google Java oracle: typing-0" {
  let f = @dialnumber.AsYouTypeFormatter::new("GB")
  let mismatches : Array[String] = []
  let actual_0 = f.input_digit('0')
  if actual_0 != "0" {
    mismatches.push("typing-0/0 actual=[" + actual_0 + "]")
  }
  let actual_1 = f.input_digit('2')
  if actual_1 != "02" {
    mismatches.push("typing-0/1 actual=[" + actual_1 + "]")
  }
  let actual_2 = f.input_digit('0')
  if actual_2 != "020" {
    mismatches.push("typing-0/2 actual=[" + actual_2 + "]")
  }
  let actual_3 = f.input_digit('7')
  if actual_3 != "020 7" {
    mismatches.push("typing-0/3 actual=[" + actual_3 + "]")
  }
  let actual_4 = f.input_digit('9')
  if actual_4 != "020 79" {
    mismatches.push("typing-0/4 actual=[" + actual_4 + "]")
  }
  let actual_5 = f.input_digit('4')
  if actual_5 != "020 794" {
    mismatches.push("typing-0/5 actual=[" + actual_5 + "]")
  }
  let actual_6 = f.input_digit('6')
  if actual_6 != "020 7946" {
    mismatches.push("typing-0/6 actual=[" + actual_6 + "]")
  }
  let actual_7 = f.input_digit('0')
  if actual_7 != "020 7946 0" {
    mismatches.push("typing-0/7 actual=[" + actual_7 + "]")
  }
  let actual_8 = f.input_digit('9')
  if actual_8 != "020 7946 09" {
    mismatches.push("typing-0/8 actual=[" + actual_8 + "]")
  }
  let actual_9 = f.input_digit('5')
  if actual_9 != "020 7946 095" {
    mismatches.push("typing-0/9 actual=[" + actual_9 + "]")
  }
  let actual_10 = f.input_digit('8')
  if actual_10 != "020 7946 0958" {
    mismatches.push("typing-0/10 actual=[" + actual_10 + "]")
  }
  for mismatch in mismatches {
    println("JAVA_COMPAT " + mismatch)
  }
  assert_eq(mismatches.length(), 0)
}

