  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "0872124750126") is None,
  )
  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "0324698686965") is None,
  )
  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "00324698686965") is None,
  )
  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "84957947638616") is None,
  )
  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "084957947638616") is None,
  )
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "186318948865923").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "0186318948865923") is None,
  )
  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "0362917520995847") is None,
  )
  assert_true(
    match_national_prefix("([2-9]\\d{6})$|1", "00362917520995847") is None,
  )
}
