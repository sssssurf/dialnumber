///|
test "independent prefix captures: KN" {
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "8692361234") is None)
  {
    let matched = match_national_prefix("([2-7]\\d{6})$|1", "18692361234").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "8697652917") is None)
  {
    let matched = match_national_prefix("([2-7]\\d{6})$|1", "18697652917").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "8002123456") is None)
  {
    let matched = match_national_prefix("([2-7]\\d{6})$|1", "18002123456").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "9002123456") is None)
  {
    let matched = match_national_prefix("([2-7]\\d{6})$|1", "19002123456").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "5002345678") is None)
  {
    let matched = match_national_prefix("([2-7]\\d{6})$|1", "15002345678").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "83979") is None)
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "083979") is None)
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "390252") is None)
  assert_true(match_national_prefix("([2-7]\\d{6})$|1", "0390252") is None)
