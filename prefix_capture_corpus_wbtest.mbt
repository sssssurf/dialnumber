///|
test "independent prefix captures: BB" {
  assert_true(match_national_prefix("([2-9]\\d{6})$|1", "2464123456") is None)
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "12464123456").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-9]\\d{6})$|1", "2462501234") is None)
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "12462501234").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
