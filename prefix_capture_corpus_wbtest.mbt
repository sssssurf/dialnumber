///|
test "independent prefix captures: AS" {
  assert_true(match_national_prefix("([267]\\d{6})$|1", "6846221234") is None)
  {
    let matched = match_national_prefix("([267]\\d{6})$|1", "16846221234").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([267]\\d{6})$|1", "6847331234") is None)
  {
    let matched = match_national_prefix("([267]\\d{6})$|1", "16847331234").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([267]\\d{6})$|1", "8002123456") is None)
  {
    let matched = match_national_prefix("([267]\\d{6})$|1", "18002123456").unwrap()
