  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "18002123456").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-9]\\d{6})$|1", "9002123456") is None)
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "19002123456").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-9]\\d{6})$|1", "2463101234") is None)
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "12463101234").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
