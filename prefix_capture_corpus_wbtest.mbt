///|
test "independent prefix captures: GD" {
  assert_true(match_national_prefix("([2-9]\\d{6})$|1", "4732691234") is None)
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "14732691234").unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None])
  }
  assert_true(match_national_prefix("([2-9]\\d{6})$|1", "4734031234") is None)
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "14734031234").unwrap()
