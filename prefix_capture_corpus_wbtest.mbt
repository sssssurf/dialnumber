///|
test "independent prefix captures: GU" {
  assert_true(match_national_prefix("([2-9]\\d{6})$|1", "6713001234") is None)
  {
    let matched = match_national_prefix("([2-9]\\d{6})$|1", "16713001234").unwrap()
    assert_eq(matched.end, 1)
