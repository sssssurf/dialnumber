///|
test "independent prefix captures: BR" {
  assert_true(
    match_national_prefix(
      "(?:0|90)(?:(1[245]|2[1-35]|31|4[13]|[56]5|99)(\\d{10,11}))?", "1123456789",
    )
    is None,
  )
  {
    let matched = match_national_prefix(
      "(?:0|90)(?:(1[245]|2[1-35]|31|4[13]|[56]5|99)(\\d{10,11}))?", "01123456789",
    ).unwrap()
    assert_eq(matched.end, 1)
    assert_eq(matched.captures, [None, None, None])
