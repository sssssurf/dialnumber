        )
      }
      if @dialnumber.is_possible(p) != false {
        differences.push(
          "IL:o:overlong/possible expected=false actual=" +
          @dialnumber.is_possible(p).to_string(),
        )
      }
    }
  }
  for difference in differences {
    println("COMPAT " + difference)
  }
  assert_eq(differences.length(), 0)
}

