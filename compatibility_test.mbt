///|
test "oracle typing: GB 02079460958" {
  let formatter = @dialnumber.AsYouTypeFormatter::new("GB")
  assert_eq(formatter.input_digit('0'), "0")
  assert_eq(formatter.input_digit('2'), "02")
  assert_eq(formatter.input_digit('0'), "020")
  assert_eq(formatter.input_digit('7'), "020 7")
  assert_eq(formatter.input_digit('9'), "020 79")
  assert_eq(formatter.input_digit('4'), "020 794")
  assert_eq(formatter.input_digit('6'), "020 7946")
  assert_eq(formatter.input_digit('0'), "020 7946 0")
  assert_eq(formatter.input_digit('9'), "020 7946 09")
  assert_eq(formatter.input_digit('5'), "020 7946 095")
  assert_eq(formatter.input_digit('8'), "020 7946 0958")
}

///|
test "oracle typing: US 2015550123" {
  let formatter = @dialnumber.AsYouTypeFormatter::new("US")
  assert_eq(formatter.input_digit('2'), "2")
  assert_eq(formatter.input_digit('0'), "20")
  assert_eq(formatter.input_digit('1'), "(201)")
  assert_eq(formatter.input_digit('5'), "(201) 5")
  assert_eq(formatter.input_digit('5'), "(201) 55")
  assert_eq(formatter.input_digit('5'), "(201) 555")
  assert_eq(formatter.input_digit('0'), "(201) 555-0")
  assert_eq(formatter.input_digit('1'), "(201) 555-01")
  assert_eq(formatter.input_digit('2'), "(201) 555-012")
  assert_eq(formatter.input_digit('3'), "(201) 555-0123")
}

///|
test "oracle typing: US 12015550123" {
  let formatter = @dialnumber.AsYouTypeFormatter::new("US")
  assert_eq(formatter.input_digit('1'), "1")
  assert_eq(formatter.input_digit('2'), "1 2")
  assert_eq(formatter.input_digit('0'), "1 20")
  assert_eq(formatter.input_digit('1'), "1 (201)")
  assert_eq(formatter.input_digit('5'), "1 (201) 5")
  assert_eq(formatter.input_digit('5'), "1 (201) 55")
  assert_eq(formatter.input_digit('5'), "1 (201) 555")
  assert_eq(formatter.input_digit('0'), "1 (201) 555-0")
  assert_eq(formatter.input_digit('1'), "1 (201) 555-01")
  assert_eq(formatter.input_digit('2'), "1 (201) 555-012")
  assert_eq(formatter.input_digit('3'), "1 (201) 555-0123")
}

///|
test "oracle typing: US +442079460958" {
  let formatter = @dialnumber.AsYouTypeFormatter::new("US")
  assert_eq(formatter.input_digit('+'), "+")
  assert_eq(formatter.input_digit('4'), "+4")
  assert_eq(formatter.input_digit('4'), "+44")
  assert_eq(formatter.input_digit('2'), "+44 2")
  assert_eq(formatter.input_digit('0'), "+44 20")
  assert_eq(formatter.input_digit('7'), "+44 20 7")
  assert_eq(formatter.input_digit('9'), "+44 20 79")
  assert_eq(formatter.input_digit('4'), "+44 20 794")
  assert_eq(formatter.input_digit('6'), "+44 20 7946")
  assert_eq(formatter.input_digit('0'), "+44 20 7946 0")
  assert_eq(formatter.input_digit('9'), "+44 20 7946 09")
  assert_eq(formatter.input_digit('5'), "+44 20 7946 095")
  assert_eq(formatter.input_digit('8'), "+44 20 7946 0958")
}

///|
test "oracle typing: JP 09012345678" {
  let formatter = @dialnumber.AsYouTypeFormatter::new("JP")
  assert_eq(formatter.input_digit('0'), "0")
  assert_eq(formatter.input_digit('9'), "09")
  assert_eq(formatter.input_digit('0'), "090")
  assert_eq(formatter.input_digit('1'), "090-1")
  assert_eq(formatter.input_digit('2'), "090-12")
  assert_eq(formatter.input_digit('3'), "090-123")
  assert_eq(formatter.input_digit('4'), "090-1234")
  assert_eq(formatter.input_digit('5'), "090-1234-5")
  assert_eq(formatter.input_digit('6'), "090-1234-56")
  assert_eq(formatter.input_digit('7'), "090-1234-567")
  assert_eq(formatter.input_digit('8'), "090-1234-5678")
}

///|
test "oracle typing: US 201555012345678" {
  let formatter = @dialnumber.AsYouTypeFormatter::new("US")
  assert_eq(formatter.input_digit('2'), "2")
  assert_eq(formatter.input_digit('0'), "20")
  assert_eq(formatter.input_digit('1'), "(201)")
  assert_eq(formatter.input_digit('5'), "(201) 5")
  assert_eq(formatter.input_digit('5'), "(201) 55")
  assert_eq(formatter.input_digit('5'), "(201) 555")
  assert_eq(formatter.input_digit('0'), "(201) 555-0")
  assert_eq(formatter.input_digit('1'), "(201) 555-01")
  assert_eq(formatter.input_digit('2'), "(201) 555-012")
  assert_eq(formatter.input_digit('3'), "(201) 555-0123")
  assert_eq(formatter.input_digit('4'), "20155501234")
  assert_eq(formatter.input_digit('5'), "201555012345")
  assert_eq(formatter.input_digit('6'), "2015550123456")
  assert_eq(formatter.input_digit('7'), "20155501234567")
  assert_eq(formatter.input_digit('8'), "201555012345678")
}
