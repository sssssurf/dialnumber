  match @dialnumber.parse("020 7946 0958", "GB") {
    None => differences.push("format:GB/parse: unexpectedly rejected")
    Some(p) => {
      if @dialnumber.is_valid(p) != true {
        differences.push(
          "format:GB/valid expected=true actual=" +
          @dialnumber.is_valid(p).to_string(),
        )
      }
      if @dialnumber.is_possible(p) != true {
        differences.push(
          "format:GB/possible expected=true actual=" +
          @dialnumber.is_possible(p).to_string(),
        )
      }
      if @dialnumber.format_e164(p) != "+442079460958" {
        differences.push(
          "format:GB/e164 expected=+442079460958 actual=" +
          @dialnumber.format_e164(p).to_string(),
        )
      }
      if @dialnumber.region_of_number(p).unwrap_or("") != "GB" {
        differences.push(
          "format:GB/region expected=GB actual=" +
          @dialnumber.region_of_number(p).unwrap_or("").to_string(),
        )
      }
      if (match @dialnumber.number_type(p) {
          Some(t) => t.to_string()
          None => ""
        }) !=
        "fixed-line" {
        differences.push(
